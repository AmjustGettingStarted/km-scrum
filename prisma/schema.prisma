generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGER
  SCRUM_MASTER
  DEVELOPER
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  PENDING
  TESTING
  RELEASED
  COMPLETED
}

enum RequestCategory {
  LEAVE
  COMPLAINT
  GENERAL
}

enum LeaveType {
  SICK
  CASUAL
  ANNUAL
  UNPAID
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  RESOLVED
  CLOSED
}

model User {
  id                   String     @id @default(uuid())
  username             String     @unique
  password_hash        String
  full_name            String
  email                String?    @unique
  role                 UserRole   @default(DEVELOPER)
  is_active            Boolean    @default(true)
  must_change_password Boolean    @default(false)
  created_at           DateTime   @default(now())
  updated_at           DateTime   @updatedAt

  sessions             Session[]
  assigned_tasks       Task[]              @relation("TaskAssignee")
  created_tasks        Task[]              @relation("TaskCreator")
  status_changes       TaskStatusHistory[]
  uploaded_files       Attachment[]
  submitted_requests   Request[]           @relation("RequestSubmitter")
  reviewed_requests    Request[]           @relation("RequestReviewer")
  request_actions      RequestHistory[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  token_hash String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  ip_address String?
  user_agent String?
  created_at DateTime @default(now())

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model Task {
  id             String          @id @default(uuid())
  task_code      String          @unique
  title          String
  description    String          @db.Text
  assigned_to_id String?
  assigned_to    User?           @relation("TaskAssignee", fields: [assigned_to_id], references: [id], onDelete: SetNull)
  created_by_id  String
  created_by     User            @relation("TaskCreator", fields: [created_by_id], references: [id])
  priority       TaskPriority    @default(MEDIUM)
  status         TaskStatus      @default(TO_DO)
  scheduled_date DateTime        @db.Date
  due_date       DateTime?
  order_index    Float           @default(1000.0)
  is_archived    Boolean         @default(false)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  status_history TaskStatusHistory[]
  attachments    Attachment[]

  @@index([assigned_to_id, scheduled_date])
  @@index([scheduled_date, status])
  @@index([status, order_index])
  @@index([is_archived])
  @@map("tasks")
}

model TaskStatusHistory {
  id              String      @id @default(uuid())
  task_id         String
  task            Task        @relation(fields: [task_id], references: [id], onDelete: Cascade)
  previous_status TaskStatus
  new_status      TaskStatus
  changed_by_id   String
  changed_by      User        @relation(fields: [changed_by_id], references: [id])
  reason          String      @db.Text
  created_at      DateTime    @default(now())

  @@index([task_id, created_at(sort: Desc)])
  @@index([changed_by_id])
  @@map("task_status_history")
}

model Attachment {
  id             String   @id @default(uuid())
  task_id        String
  task           Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  file_name      String
  file_key       String   @unique
  file_size      BigInt
  mime_type      String
  uploaded_by_id String
  uploaded_by    User     @relation(fields: [uploaded_by_id], references: [id])
  created_at     DateTime @default(now())

  @@index([task_id])
  @@map("attachments")
}

model Request {
  id               String          @id @default(uuid())
  request_code     String          @unique
  user_id          String
  user             User            @relation("RequestSubmitter", fields: [user_id], references: [id])
  category         RequestCategory
  subject          String
  description      String          @db.Text
  leave_type       LeaveType?
  start_date       DateTime?       @db.Date
  end_date         DateTime?       @db.Date
  status           RequestStatus   @default(PENDING)
  reviewed_by_id   String?
  reviewed_by      User?           @relation("RequestReviewer", fields: [reviewed_by_id], references: [id])
  reviewer_remarks String?         @db.Text
  reviewed_at      DateTime?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  history          RequestHistory[]

  @@index([user_id, category])
  @@index([category, status])
  @@index([category, status, start_date, end_date])
  @@map("requests")
}

model RequestHistory {
  id              String   @id @default(uuid())
  request_id      String
  request         Request  @relation(fields: [request_id], references: [id], onDelete: Cascade)
  action          String
  previous_status String?
  new_status      String?
  changed_by_id   String
  changed_by      User     @relation(fields: [changed_by_id], references: [id])
  remarks         String?  @db.Text
  created_at      DateTime @default(now())

  @@index([request_id, created_at(sort: Desc)])
  @@map("request_history")
}
